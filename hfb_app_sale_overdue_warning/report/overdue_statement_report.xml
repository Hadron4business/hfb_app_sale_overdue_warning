<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_overdue_statement" model="ir.actions.report">
        <field name="name">Overdue Statement</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hfb_app_sale_overdue_warning.report_overdue_statement</field>
        <field name="print_report_name">'Overdue Statement - %s' % (object.name)</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_overdue_statement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-set="lines" t-value="o.get_overdue_statement_lines()"/>
                    <t t-set="currency" t-value="o.env.company.currency_id"/>
                    <div class="page">
                        <div class="row mb-4">
                            <div class="col-6 offset-6">
                                <div t-field="o.commercial_partner_id"
                                     t-options="{'widget': 'contact', 'fields': ['address', 'name', 'vat'], 'no_marker': True}"/>
                            </div>
                        </div>
                        <h2>Overdue Statement</h2>
                        <p>Date: <span t-out="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d')"/></p>
                        <p t-if="not lines">There are no overdue invoices.</p>
                        <table t-if="lines" class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th>Document</th>
                                    <th>Date</th>
                                    <th>Due Date</th>
                                    <th class="text-end">Days Overdue</th>
                                    <th class="text-end">Total</th>
                                    <th class="text-end">Amount Due</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="lines" t-as="line">
                                    <td><span t-out="line['move'].name"/></td>
                                    <td><span t-out="line['date']" t-options="{'widget': 'date'}"/></td>
                                    <td><span t-out="line['due']" t-options="{'widget': 'date'}"/></td>
                                    <td class="text-end"><span t-out="line['days']"/></td>
                                    <td class="text-end"><span t-out="line['total']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                    <td class="text-end"><span t-out="line['residual']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="5" class="text-end"><strong>Total Overdue</strong></td>
                                    <td class="text-end"><strong t-out="sum(l['residual'] for l in lines)" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
