<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="mail_template_overdue_statement" model="mail.template">
            <field name="name">Customer: Overdue Statement</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">{{ (object.env.company.name) }} - overdue invoices</field>
            <field name="partner_to">{{ object.id }}</field>
            <field name="report_template_ids" eval="[(4, ref('action_report_overdue_statement'))]"/>
            <field name="lang">{{ object.lang }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p>Dear <t t-out="object.name or ''">customer</t>,</p>
    <p>According to our records, the following amount is overdue:
        <strong t-out="format_amount(object.overdue_amount, object.overdue_currency_id) or ''">$ 1,000.00</strong>.
        The details are in the attached statement.</p>
    <p>If you have already paid, please ignore this message. Thank you!</p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>
