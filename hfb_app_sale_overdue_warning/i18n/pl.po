#. module: hfb_app_sale_overdue_warning
#. odoo-python
#: code:addons/hfb_app_sale_overdue_warning/models/sale_order.py:0
msgid ""
"%(customer)s has overdue invoices for %(amount)s. Only a sales manager can "
"confirm %(order)s."
msgstr ""
"%(customer)s ma przeterminowane faktury na kwotę %(amount)s. Tylko kierownik"
" sprzedaży może potwierdzić %(order)s."

#. module: hfb_app_sale_overdue_warning
#: model:ir.actions.report,print_report_name:hfb_app_sale_overdue_warning.action_report_overdue_statement
msgid "'Overdue Statement - %s' % (object.name)"
msgstr "'Zestawienie zaległości - %s' % (object.name)"

#. module: hfb_app_sale_overdue_warning
#: model:mail.template,body_html:hfb_app_sale_overdue_warning.mail_template_overdue_statement
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>Dear <t t-out=\"object.name or ''\">customer</t>,</p>\n"
"    <p>According to our records, the following amount is overdue:\n"
"        <strong t-out=\"format_amount(object.overdue_amount, object.overdue_currency_id) or ''\">$ 1,000.00</strong>.\n"
"        The details are in the attached statement.</p>\n"
"    <p>If you have already paid, please ignore this message. Thank you!</p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>Dzień dobry, <t t-out=\"object.name or ''\">customer</t>,</p>\n"
"    <p>Według naszych danych przeterminowana jest kwota:\n"
"        <strong t-out=\"format_amount(object.overdue_amount, object.overdue_currency_id) or ''\">$ 1,000.00</strong>.\n"
"        Szczegóły są w załączonym zestawieniu.</p>\n"
"    <p>Jeśli płatność została już wykonana, prosimy zignorować tę wiadomość. Dziękujemy!</p>\n"
"</div>\n"
"            "

