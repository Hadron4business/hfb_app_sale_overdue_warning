<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_overdue" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.overdue</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']" position="inside">
                <setting id="overdue_warning" company_dependent="1"
                         help="Warn on quotations when the customer has overdue invoices">
                    <div class="content-group">
                        <div class="row">
                            <label for="overdue_tolerance_days" class="col-lg-6 o_light_label"/>
                            <field name="overdue_tolerance_days" class="oe_inline"/>
                        </div>
                        <div class="mt8">
                            <field name="overdue_block_confirmation" class="oe_inline"/>
                            <label for="overdue_block_confirmation" class="o_light_label"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
